[Desktop Entry]
Type=Application
Name=GDAP Acceptor
Exec=/opt/gdap-acceptor/gdap-acceptor %u
TryExec=/opt/gdap-acceptor/gdap-acceptor
Terminal=true
MimeType=x-scheme-handler/gdap-acceptor;
Categories=Utility;
Comment=Paste a Microsoft GDAP invitation and accept it in the customer tenant
NoDisplay=false
