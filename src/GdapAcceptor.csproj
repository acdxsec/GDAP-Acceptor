<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gdap-acceptor</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.4.2</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(DeploymentProfile)" LogicalName="Gdap.DeploymentProfile" Condition="'$(DeploymentProfile)' != ''" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.90.0" />
    <ProjectReference Include="../shared/StatusProtocol.csproj" />
    <InternalsVisibleTo Include="StateContracts" />
    <InternalsVisibleTo Include="LauncherContracts" />
  </ItemGroup>
</Project>
